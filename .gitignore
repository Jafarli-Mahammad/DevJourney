## ==========================================
## DevJourney Solution .gitignore
## Essential rules for .NET C# Web Application
## ==========================================

# 1. .NET Build & Output Directories
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
publish/
artifacts/

# 2. IDE & User Specific Files
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# 3. Environment, Secrets & Local Overrides
.env
.env.*
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
appsettings.Staging.json
appsettings.*.user.json
!appsettings.json
secrets.json
*.pem
*.key
*.pfx
*.cer
*.crt

# 4. Test Results & Code Coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# 5. OS & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*.log
*.tmp
*.cache
*.swp
*.stackdump

# 6. Tooling & Test Generator Directories
.hypothesis/
.schemathesis/
.junie/
.aider*
